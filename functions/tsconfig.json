{
  "compilerOptions": {
    "module": "CommonJS",
    "noImplicitReturns": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
