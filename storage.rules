rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function getUserDocFromNamedDb() {
      return firestore.get(/databases/ai-studio-smartmindpos-3ebff8f1-fed5-4111-b7db-f027e942fbb4/documents/users/$(request.auth.uid)).data;
    }

    function getUserDocFromDefaultDb() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDocInNamedDb() {
      return isAuthenticated() &&
        firestore.exists(/databases/ai-studio-smartmindpos-3ebff8f1-fed5-4111-b7db-f027e942fbb4/documents/users/$(request.auth.uid));
    }

    function hasUserDocInDefaultDb() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return hasUserDocInNamedDb() || hasUserDocInDefaultDb();
    }

    function getUserProfile() {
      return hasUserDocInNamedDb() ? getUserDocFromNamedDb() : getUserDocFromDefaultDb();
    }

    function isAuthorizedTenantMember(businessId) {
      return hasUserDoc() &&
        getUserProfile().status == 'active' &&
        getUserProfile().businessId == businessId;
    }

    function isPlatformAdmin() {
      return hasUserDoc() &&
        getUserProfile().status == 'active' &&
        getUserProfile().role == 'platform_admin' &&
        (request.auth.token.email == "smartnwokolo@gmail.com" ||
         request.auth.token.email == "smart@smartmindconcept.com");
    }

    function isBusinessOwnerOf(businessId) {
      return isAuthorizedTenantMember(businessId) &&
        getUserProfile().role == 'business_owner';
    }

    function isAssignedShopManager(businessId, shopId) {
      return isAuthorizedTenantMember(businessId) &&
        getUserProfile().role == 'shop_manager' &&
        ((('shopId' in getUserProfile()) && getUserProfile().shopId == shopId) ||
         (('assignedShopIds' in getUserProfile()) && getUserProfile().assignedShopIds is list && shopId in getUserProfile().assignedShopIds));
    }

    function isValidLogoFile() {
      return request.resource.size <= 512 * 1024 &&
        (request.resource.contentType.matches('image/png') ||
         request.resource.contentType.matches('image/jpeg') ||
         request.resource.contentType.matches('image/webp'));
    }

    // ===============================================================
    // Branding Rules (Restricted to Exact Canonical Object Names)
    // ===============================================================

    // Business-wide branding: businesses/{businessId}/branding/business-logo
    match /businesses/{businessId}/branding/business-logo {
      allow read: if isPlatformAdmin() || isAuthorizedTenantMember(businessId);

      allow write: if (isPlatformAdmin() || isBusinessOwnerOf(businessId)) &&
        isValidLogoFile();

      allow delete: if isPlatformAdmin() || isBusinessOwnerOf(businessId);
    }

    // Shop-specific branding: businesses/{businessId}/shops/{shopId}/branding/shop-logo
    match /businesses/{businessId}/shops/{shopId}/branding/shop-logo {
      allow read: if isPlatformAdmin() || isAuthorizedTenantMember(businessId);

      allow write: if (isPlatformAdmin() || isBusinessOwnerOf(businessId) || isAssignedShopManager(businessId, shopId)) &&
        isValidLogoFile();

      allow delete: if isPlatformAdmin() || isBusinessOwnerOf(businessId) || isAssignedShopManager(businessId, shopId);
    }

    // Catch-all deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
