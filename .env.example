# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# ENVIRONMENT SEPARATION: PRODUCTION vs STAGING
# =============================================================================
# To target the STAGING environment (smartmind-pos-staging), set these variables
# in your local .env or deployment environment:
#
# VITE_FIREBASE_PROJECT_ID="smartmind-pos-staging"
# VITE_FIREBASE_API_KEY="<STAGING_WEB_API_KEY_FROM_FIREBASE_CONSOLE>"
# VITE_FIREBASE_AUTH_DOMAIN="smartmind-pos-staging.firebaseapp.com"
# VITE_FIREBASE_STORAGE_BUCKET="smartmind-pos-staging.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="<STAGING_MESSAGING_SENDER_ID>"
# VITE_FIREBASE_APP_ID="<STAGING_APP_ID>"
# VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
#
# Server-side Cloud Functions environment variables (set in Cloud Functions configuration):
# FIRESTORE_DATABASE_ID="(default)"
#
# CRITICAL SECURITY RULE:
# Staging (smartmind-pos-staging) is strictly blocked by code from accessing
# the production database "ai-studio-smartmindpos-3ebff8f1-fed5-4111-b7db-f027e942fbb4".
#
# PRODUCTION CONFIGURATION (Default baseline in firebase-applet-config.json):
# Project ID: gen-lang-client-0985802946
# Named Database ID: ai-studio-smartmindpos-3ebff8f1-fed5-4111-b7db-f027e942fbb4
# =============================================================================

VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_USE_FIREBASE_EMULATORS="false"

