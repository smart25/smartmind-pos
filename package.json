{
  "name": "smartmind-pos",
  "productName": "SmartMind POS",
  "description": "SmartMind Multi-Shop Point of Sale & Inventory Management System",
  "author": "SmartMind Technologies",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "test:storage:rules": "firebase emulators:exec --only firestore,storage --config firebase.staging.json --project smartmind-pos-staging \"tsx --test src/db/storageRulesEmulator.test.ts\"",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:staging": "vite --mode staging --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/preload.cjs",
    "build:all": "npm run build && npm run build:electron",
    "dist": "npm run build && npm run build:electron && electron-builder",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"npm run build:electron && electron .\"",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js release",
    "test": "tsx --test src/utils/posCalculations.test.ts src/db/phase5.test.ts src/db/phase6.test.ts src/db/quarantineCleanup.test.ts src/db/electronStage1.test.ts src/db/stagingIsolation.test.ts src/db/indexedDbAdapterCleanup.integration.test.ts src/db/indexedDbAdapterIsolation.test.ts src/db/indexedDbTransactionSafety.test.ts",
    "test:rules": "tsx --test src/db/firestoreRulesEmulator.test.ts",
    "test:rules:emulator": "firebase emulators:exec --only firestore --project gen-lang-client-0985802946 \"npm run test:rules\"",
    "test:firestore:rules": "firebase emulators:exec --only firestore --config firebase.staging.json --project smartmind-pos-staging \"tsx --test src/db/firestoreStagingRulesEmulator.test.ts\"",
    "lint": "tsc --noEmit",
    "deploy:staging": "firebase deploy --project smartmind-pos-staging --config firebase.staging.json",
    "deploy:staging:functions": "firebase deploy --only functions --project smartmind-pos-staging --config firebase.staging.json",
    "deploy:staging:rules": "firebase deploy --only firestore:rules --project smartmind-pos-staging --config firebase.staging.json",
    "deploy:staging:indexes": "firebase deploy --only firestore:indexes --project smartmind-pos-staging --config firebase.staging.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "build": {
    "appId": "com.smartmindpos.desktop",
    "productName": "SmartMind POS",
    "copyright": "Copyright © 2026 SmartMind Technologies",
    "publish": [
      {
        "provider": "github",
        "owner": "smart25",
        "repo": "smartmind-pos"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SmartMind-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SmartMind POS",
      "uninstallDisplayName": "SmartMind POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "dmg": {
      "title": "SmartMind POS ${version}",
      "icon": "build/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
